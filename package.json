{
  "name": "moto",
  "version": "2.0.0-beta.2",
  "private": true,
  "type": "module",
  "description": "MOTO: studio di motion graphic unificato con montaggio, UI Training e accessibilità",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prepare-site.mjs",
